# Base URL of the FastAPI backend (backend/main.py). Never point this at
# TMDB, Supabase, or Postgres directly (AGENTS.md §12).
# For a physical device, this must be your development machine's LAN IP,
# not localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Error monitoring (Sentry) and product analytics (PostHog) — spec 0003.
# Both stay disabled in local dev builds (see lib/telemetry.ts isEnabled());
# only required for a real preview/production build.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_API_KEY=
# Defaults to PostHog Cloud US if unset.
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Web build only (spec 0014). Leave both empty for local development.
# SITE_URL is the public https address with no path, e.g. https://nextwatch-web.<account>.workers.dev
# and feeds the canonical and og:url links. NOINDEX=1 is set by CI on pull
# request previews only, and adds a robots noindex tag. A bad value fails the export.
EXPO_PUBLIC_SITE_URL=
EXPO_PUBLIC_NOINDEX=

# Build-time only (EAS secrets, never in .env / never bundled into the app):
# SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT — used by the Sentry Expo
# config plugin to upload source maps during `eas build`.
